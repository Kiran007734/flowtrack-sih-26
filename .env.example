# Copy this file to .env for local Docker development. Never commit .env.
# Values below are deliberately non-production placeholders. Generate a unique
# POSTGRES_PASSWORD, POSTGRES_APP_PASSWORD, and TOKEN_SIGNING_SECRET before
# running the local stack.

APP_NAME=AICTE FlowTrack
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
TIMEZONE=UTC

# PostgreSQL. POSTGRES_USER is the Compose initialization owner; the API/worker
# use the separate non-superuser application account below.
POSTGRES_DB=flowtrack
POSTGRES_USER=flowtrack_owner
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_APP_USER=flowtrack_app
POSTGRES_APP_PASSWORD=replace-with-a-different-local-development-password
DATABASE_URL=postgresql+psycopg://flowtrack_app:replace-with-a-different-local-development-password@postgres:5432/flowtrack

# Redis is coordination/cache only; PostgreSQL remains authoritative.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Authentication (local development only; replace before institutional deployment)
TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-characters
TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
TOKEN_ISSUER=flowtrack-local
TOKEN_AUDIENCE=flowtrack-web

# Browser/API integration
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Private file storage. This path is mounted only into API and worker containers.
PRIVATE_STORAGE_BACKEND=local
PRIVATE_STORAGE_ROOT=/var/lib/flowtrack/private
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_DOCUMENT_TYPES=application/pdf,image/png,image/jpeg,text/plain

# Development-only synthetic seed guard. The seed command also rejects production.
ENABLE_DEVELOPMENT_SEED=true
# Required only when running the synthetic seed. Choose a unique local value;
# the seed command rejects this placeholder and no demo password is committed.
DEVELOPMENT_SEED_PASSWORD=replace-with-a-unique-local-synthetic-seed-password

# External channels are intentionally unconfigured in Phase 2.
NOTIFICATION_PROVIDER=
NOTIFICATION_PROVIDER_CONFIG=

# Placeholder extension points; no KMS or malware scanning integration is claimed.
KMS_KEY_ID=
STORAGE_ENCRYPTION_ENABLED=false
MALWARE_SCAN_ENABLED=false
